{
  "name": "h-lens-cinematic",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node scripts/build-site.mjs",
    "build:preview": "tsc -b && cross-env H_LENS_BUILD_TARGET=preview node scripts/build-site.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:seo": "node scripts/test-seo-build.mjs",
    "seo:inventory": "node scripts/check-wordpress-url-inventory.mjs",
    "verify": "npm run lint && npm run build && npm run test:seo"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@supabase/supabase-js": "2.57.4",
    "gsap": "^3.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^10.0.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
